# ─── Required in production ────────────────────────────────────────────
# Signs the session cookie: openssl rand -base64 32
AUTH_SECRET=
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token): openssl rand -hex 24
CRON_SECRET=
# Public URL, used for Google sign-in redirects. e.g. https://docent.example.com
# APP_URL=

# ─── Database ─────────────────────────────────────────────────────────
# Unset → embedded Postgres (PGlite) in .data/pglite. Fine for dev and a single server with a disk.
# Vercel/serverless → a hosted Postgres. Use the POOLED connection string:
#   Neon:     postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgres://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
# DATABASE_URL=

# ─── Photo storage ────────────────────────────────────────────────────
# local (default): files in PHOTO_DIR. Needs a persistent disk.
# s3: any S3-compatible bucket. Cloudflare R2 is free up to 10 GB with no egress fees.
# STORAGE_DRIVER=s3
# PHOTO_DIR=.data/photos
#   R2:       S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   S3_REGION=auto
#   Supabase: S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3     S3_REGION=<project region>
# S3_ENDPOINT=
# S3_BUCKET=docent-photos
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── Sign-in ──────────────────────────────────────────────────────────
# Email codes via Resend (free: 3,000/month). Without a key, dev prints codes to the server log;
# production hides email sign-in.
# RESEND_API_KEY=
# EMAIL_FROM="Docent <hello@your-domain.com>"
# Google (optional): console.cloud.google.com → Credentials → OAuth client (Web).
# Authorised redirect URI: $APP_URL/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Notifications (optional) ─────────────────────────────────────────
# pnpm vapid prints a key pair.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ─── Data ingestion ───────────────────────────────────────────────────
# INGEST_USER_AGENT="Docent/1.0 (your-contact@example.com)"
# WIKIDATA_FALLBACK_ENDPOINT=https://qlever.dev/api/wikidata
# POOL_MIN_SITELINKS=8
